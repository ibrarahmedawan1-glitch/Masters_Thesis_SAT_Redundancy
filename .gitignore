# --- Tool Binaries (Don't track the tools themselves if they are compiled) ---
abc/
aiger/
yosys/

# --- Operating System Junk ---
.DS_Store
Thumbs.db

# --- Exceptions (Rules to force-keep specific things) ---
# We DO want to keep your results summary!
!thesis_benchmarks/thesis_results_final.csv
# We DO want to keep your source Verilog files
!verilog_files/